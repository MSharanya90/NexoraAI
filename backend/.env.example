# ==============================================================================
# AI-Powered Website Link Analysis API - Environment Configuration
# ==============================================================================

# Application Configuration
APP_NAME="AI-Powered Website Link Analysis API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=false
HOST="0.0.0.0"
PORT=8000
LOG_LEVEL="INFO"
CORS_ORIGINS=["*"]

# LLM Provider Configuration
# Choose active provider: 'gemini', 'openai', 'anthropic', or 'mock'
LLM_PROVIDER="gemini"
LLM_FALLBACK_PROVIDER="openai"

# Google Gemini API Configuration (Recommended Default)
# Obtain key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"

# OpenAI API Configuration
# Obtain key at: https://platform.openai.com/api-keys
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# Anthropic Claude API Configuration
# Obtain key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
ANTHROPIC_MODEL="claude-3-5-haiku-20241022"

# LLM Generation Parameters
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=4096

# Security & Extraction Engine Settings
REQUEST_TIMEOUT_SECONDS=15.0
MAX_REDIRECTS=5
MAX_RESPONSE_BYTES=5242880  # 5 MB
MAX_CONTENT_LENGTH_CHARS=14000

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600  # 1 hour
CACHE_MAX_ITEMS=500
